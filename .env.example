# Environment Mode: development | staging | production
# In 'development', emails are created as Gmail Drafts only
ENVIRONMENT=development

# LLM API Configuration (Gemini API Key or alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-pro

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Google Workspace MCP Server (Headless Cloud)
# Public Endpoint: https://web-production-c16ea.up.railway.app
MCP_SERVER_URL=https://web-production-c16ea.up.railway.app
API_KEY=saiprasad@13

# Local Audit Database
AUDIT_DB_PATH=data/audit.db

# Cache Directory
CACHE_DIR=data/cache

